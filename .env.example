# Copy to .env and fill in real values.
# Project endpoint: Foundry portal -> your project -> Overview -> "Foundry project endpoint"
FOUNDRY_PROJECT_ENDPOINT=https://<your-account>.services.ai.azure.com/api/projects/<your-project>

# Deployment NAMES (not model names) that exist in this project
MEMORY_STORE_CHAT_MODEL=<chat-deployment-name>
MEMORY_STORE_EMBEDDING_MODEL=<embedding-deployment-name>

# Optional
# USER_PROFILE_DETAILS=Remember personal details, preferences, vehicles, work and schedule information.
